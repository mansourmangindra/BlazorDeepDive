@page "/servers/{id:int}"

@inject NavigationManager NavigationManager

<h3>Edit Server</h3>
<br />
<br />

@if (server != null)
{


    <EditForm Model="server" FormName="formServer" OnValidSubmit="Submit">
        <DataAnnotationsValidator></DataAnnotationsValidator>
        <InputNumber @bind-Value="server.ServerId" hidden></InputNumber>
        <div class="mb-3">
            <label for="exampleFormControlInput1" class="col-form-label">Name</label>
            <InputText @bind-Value="server.Name" class="form-control"></InputText>
            <div class="col">
                <ValidationMessage For="() => server.Name"></ValidationMessage>
            </div>
        </div>
        <div class="mb-3">
            <label for="exampleFormControlTextarea1" class="col-form-label">City</label>
            <InputText @bind-Value="server.City" class="form-control"></InputText>
            <div class="col">
                <ValidationMessage For="() => server.City"></ValidationMessage>
            </div>
        </div>
        <div class="mb-3">
            <label for="exampleFormControlTextarea1" class="col-form-label">Online</label>
            <InputCheckbox @bind-Value="server.IsOnline" class="form-check-input"></InputCheckbox>

        </div>
        <br />
        <button class="btn btn-primary" type="submit">Update</button>
        &nbsp;
        <a href="/servers" class="btn btn-primary">Close</a>

    </EditForm>
}


@code {
    [Parameter]
    public int id { get; set; }

    [SupplyParameterFromForm]
    private Server? server { get; set; }

    protected override void OnParametersSet()
    {
        server ??= ServersRepository.GetServerById(this.id);
    }

    private async Task Submit()
    {
        if (server == null)
            return;

        ServersRepository.UpdateServer(server.ServerId, server);
        try
        {
            ServersRepository.UpdateServer(server.ServerId, server);
            NavigationManager.NavigateTo("/servers");
        }
        catch (Exception ex) when (ex is not NavigationException)
        {
            // Handle actual database or business logic errors here
            // The 'when' filter ensures Blazor's redirect signal passes through safely
        }
    }

}
